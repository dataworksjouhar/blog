---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const recent = posts.slice(0, 6);

const proof = [
  '12+ years in retail and enterprise analytics',
  "Alshaya · Lowe's · Tesco · Decathlon",
  '5,600+ stores supported',
  'CEO and CTO award recognised',
  'Power BI · SQL · Python · AI agents',
];
---
<BaseLayout title="Mohammed Jouhar · Senior Business Data Analyst">
  <section class="hero">
    <canvas class="hero-canvas" id="constellation" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="eyebrow">Senior Business Data Analyst</div>
      <h1>I build the reporting, automation, and <em>AI</em> that businesses actually rely on.</h1>
      <p class="tagline">
        I'm Mohammed Jouhar. For 12+ years I've turned messy requirements into
        trusted data products, dashboards, automations, and practical AI solutions. This is
        where I write about the work.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/projects">View my work</a>
        <a class="btn btn-ghost" href="/recommendations">Recommendations</a>
        <a class="btn btn-ghost" href="https://www.linkedin.com/in/mohammed-jouhar-a631b587/" target="_blank" rel="noopener">LinkedIn</a>
      </div>
      <p class="contact-line">
        Want my CV? Email
        <a href="mailto:dataworks.jouhar@gmail.com?subject=CV%20request">dataworks.jouhar@gmail.com</a>
        and I'll send it over.
      </p>
    </div>
  </section>

  <div class="cred-strip">
    <div class="wrap">
      <ul>
        {proof.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Latest posts</h2>
        <span class="meta">notes, projects and reflections</span>
      </div>
      {recent.length > 0 ? (
        <div class="card-grid">
          {recent.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="empty reveal">
          <p><strong>Nothing here yet.</strong></p>
          <p>The first posts are on their way.</p>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>What people say</h2>
        <a class="meta" href="/recommendations">read all</a>
      </div>
      <div class="quote-grid">
        <figure class="quote-card reveal">
          <blockquote class="quote-body">
            He played a key role in developing several AI agents and solutions
            that strengthened the governance and management of our AI ecosystem.
          </blockquote>
          <figcaption class="quote-author">
            <span class="qa-name">Amine Mansour</span>
            <span class="qa-role">Managing Director &amp; Head of Data &amp; AI, Itecor</span>
          </figcaption>
        </figure>
        <figure class="quote-card reveal">
          <blockquote class="quote-body">
            Under his guidance, we developed a JIRA agent that reduced ticket
            analysis time by over 90% for Product Managers.
          </blockquote>
          <figcaption class="quote-author">
            <span class="qa-name">Sambhav Jain</span>
            <span class="qa-role">AI Intern, Alshaya Group</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-block reveal">
        <h2>Looking for someone who can do this work?</h2>
        <p>
          I'm open to senior data, BI, and AI roles. Happy to talk through any of
          these projects in detail, and I'll gladly send my CV on request.
        </p>
        <div class="cta-actions">
          <a class="btn btn-primary" href="https://www.linkedin.com/in/mohammed-jouhar-a631b587/" target="_blank" rel="noopener">Connect on LinkedIn</a>
          <a class="btn btn-ghost" href="mailto:dataworks.jouhar@gmail.com">Email me</a>
        </div>
        <p class="contact-line on-dark">
          Or reach me directly at
          <a href="mailto:dataworks.jouhar@gmail.com">dataworks.jouhar@gmail.com</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-line{
    margin-top:16px;
    font-size:14.5px;
    color:var(--ink-soft);
  }
  .contact-line a{
    color:var(--azure-deep);
    text-decoration:underline;
    text-underline-offset:2px;
    word-break:break-word;
  }
  .contact-line.on-dark{
    margin-top:18px;
    color:rgba(244,236,224,.7);
  }
  .contact-line.on-dark a{color:var(--gold)}
</style>

<script is:inline>
  (function () {
    const canvas = document.getElementById('constellation');
    if (!canvas) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d');
    let w, h, dpr, nodes = [], raf = null;

    const AZURE = '28,111,176';
    const TERRA = '200,98,59';

    function size() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.offsetWidth;
      h = canvas.offsetHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = w < 640 ? 10 : w < 1000 ? 16 : 22;
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.16,
        vy: (Math.random() - 0.5) * 0.16,
        r: Math.random() * 1.6 + 1,
        c: Math.random() > 0.78 ? TERRA : AZURE,
      }));
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        a.x += a.vx; a.y += a.vy;
        if (a.x < 0 || a.x > w) a.vx *= -1;
        if (a.y < 0 || a.y > h) a.vy *= -1;
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y;
          const dist = Math.hypot(dx, dy);
          if (dist < 150) {
            ctx.strokeStyle = 'rgba(' + AZURE + ',' + (0.1 * (1 - dist / 150)).toFixed(3) + ')';
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      for (const n of nodes) {
        ctx.fillStyle = 'rgba(' + n.c + ',0.5)';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    }

    function start() { if (!raf) draw(); }
    function stop() { if (raf) { cancelAnimationFrame(raf); raf = null; } }

    size();
    if (reduce) { draw(); stop(); }
    else {
      start();
      document.addEventListener('visibilitychange', () =>
        document.hidden ? stop() : start()
      );
    }
    let t;
    window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(size, 200); });
  })();
</script>
